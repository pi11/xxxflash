# One server block per site; each proxies to its own app process (see flash@.service).
# Paths assume the repo lives in /srv/xxxflash and MEDIA_ROOT=/srv/media/xxxflash.
upstream flash_xxxflash { server 127.0.0.1:8001; }

# Behind Cloudflare: restore the visitor IP, or votes/bans/comment checks see Cloudflare's IPs.
# /etc/nginx/cloudflare-realip.conf holds `set_real_ip_from <range>;` for every range in
# https://www.cloudflare.com/ips-v4 and /ips-v6 (see docs/deploy.md), plus:
#   real_ip_header CF-Connecting-IP;
# include /etc/nginx/cloudflare-realip.conf;

server {
    listen 80;
    server_name _;                      # set the real host name
    client_max_body_size 25m;           # MAX_UPLOAD_MB + form overhead

    # Ruffle needs WebAssembly; Metrika is the only third-party script.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://mc.yandex.ru; img-src 'self' data: blob: https://mc.yandex.ru; media-src 'self' blob:; connect-src 'self' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'" always;

    location /static/ { alias /srv/xxxflash/static/xxxflash/; expires 7d; }
    location /vendor/ { alias /srv/xxxflash/static/vendor/; expires 30d; }

    # Extensionless SWFs requested by loader games as "parts/<name>".
    location /media/parts/ {
        alias /srv/media/xxxflash/parts/;
        default_type application/x-shockwave-flash;
        expires 30d;
    }
    location /media/ {
        alias /srv/media/xxxflash/;
        types { application/x-shockwave-flash swf; image/jpeg jpg jpeg; image/png png; image/gif gif; }
        expires 30d;
    }

    location / {
        proxy_pass http://flash_xxxflash;
        proxy_set_header Host $host;
        # $remote_addr is the visitor (after real_ip above); the app trusts it from TRUSTED_PROXIES.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# nginx's mime.types must map wasm (it does in recent versions):
#   application/wasm wasm;
