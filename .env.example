# Only read by deploy/flash@.service (--port); the app ignores it.
PORT=8000
# template/static set: xxxflash | flashsex
SITE=xxxflash
# UI language: ru | en. en uses templates/<SITE>-en/ (only xxxflash-en exists).
# Not "LANGUAGE": that is the OS locale variable shells already set.
SITE_LANGUAGE=ru
# 0 hides comments everywhere and turns off the comment endpoints (used by the English site)
SHOW_COMMENTS=1
DATABASE_URL=postgres://flashxxx:123123@localhost:5432/flashxxx
# new app tables live here
DB_SCHEMA=app
# 1 when DATABASE_URL points at PgBouncer (e.g. port 6432); see docs/architecture.md
DB_PGBOUNCER=0
# legacy Django tables (copy-tool source)
LEGACY_SCHEMA=public
# swf/, th/, screenshots/, cache/ (git-ignored; real path set in production)
MEDIA_ROOT=./media
MEDIA_URL=/media/
# used in magic links / emails
SITE_URL=http://localhost:8000
SECRET_KEY=change-me
# put the real key in .env
RESEND_API_KEY=
EMAIL_FROM=no-reply@authmail.click
# comma separated, moderation notices
ADMIN_EMAILS=
ADMIN_PREFIX=secret-admin
METRIKA_ID=
GAMES_PER_PAGE=15
MAX_UPLOAD_MB=20
TRUSTED_PROXIES=127.0.0.1
# hide games whose SWF is missing/broken (leave empty if MEDIA_ROOT is not populated)
HIDE_COMPAT=missing,broken
# Machine translation of game titles/descriptions (python -m app translate)
ADTR_USER_ID=
ADTR_API_KEY=
TRANSLATE_CONCURRENCY=4
